NODE_ENV=development
PORT=8080
APP_VERSION=0.1.0
FRONTEND_ORIGIN=http://localhost:5173

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=

# App web (pnabavaliacaopro) — endpoints internos HMAC que o Worker chama pra
# gravar progresso/resultado de etapa. RAILWAY_INTERNAL_SECRET precisa ser o
# mesmo valor configurado em Cloud -> Secrets no Lovable desse app.
INTERNAL_API_BASE_URL=https://pnabavaliacaopro.lovable.app
RAILWAY_INTERNAL_SECRET=

REDIS_URL=redis://localhost:6379

OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_MODEL_EXTRACTION=gpt-5.4-nano
OPENAI_MODEL_EVALUATION=gpt-5.4-mini
OPENAI_MODEL_AUDIT=gpt-5.4-mini
OPENAI_MODEL_ESCALATION=gpt-5.4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_USE_BATCH=false
OPENAI_USE_BACKGROUND_FOR_ESCALATION=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
TOKEN_ENCRYPTION_KEY=

DEFAULT_COST_LIMIT_PER_APPLICATION_USD=5
DEFAULT_COST_LIMIT_PER_EDITAL_USD=500
MAX_CONCURRENT_APPLICATIONS=2
MAX_CONCURRENT_OPENAI_CALLS=3
MAX_STAGE_ATTEMPTS=3

STORAGE_BUCKET_ORIGINALS=application-originals
STORAGE_BUCKET_DERIVED=application-derived
STORAGE_BUCKET_EXPORTS=evaluation-exports
